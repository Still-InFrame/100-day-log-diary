# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase project: Settings → API
# Use the "publishable key" (sb_publishable_...), not the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: HighLevel lead sync + texting (owner admin → Settings explains it).
# Server-only on purpose. Never prefix these with NEXT_PUBLIC_.
# GHL_PRIVATE_TOKEN=   Private Integration Token from your HighLevel sub-account
# GHL_LOCATION_ID=     that sub-account's ID
# GHL_APP_BASE_URL=    only if you log in on a white-label domain
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
