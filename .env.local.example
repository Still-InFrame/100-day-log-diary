# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase project: Settings → API
# Use the "publishable key" (sb_publishable_...), not the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: lets each user connect their own HighLevel account (lead sync +
# texting). Without these, signups are still saved and shown in the admin.
# Server-only on purpose. Never prefix these with NEXT_PUBLIC_.
# The site owner's Admin → Settings page lists the setup steps.
#
# GHL_CLIENT_ID / GHL_CLIENT_SECRET   from your HighLevel Marketplace app
# SUPABASE_SECRET_KEY                 Supabase → Project Settings → API keys →
#                                     secret key (sb_secret_...). Bypasses Row
#                                     Level Security; used only to store each
#                                     user's HighLevel connection.
# GHL_INSTALL_URL                     optional: the app's Install Link, if it
#                                     differs from the standard format
# GHL_APP_BASE_URL                    optional: your white-label login domain
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
SUPABASE_SECRET_KEY=
